# Copy to .env.local and fill in. Never commit .env.local.

# Public base URL of the app (used in emails and redirects)
APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys / Database) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SECRET_KEY=
# Postgres connection string. Use the transaction pooler (port 6543) for the app.
DATABASE_URL=
# Direct (session, port 5432) connection string, used only by `npm run db:migrate`.
DIRECT_DATABASE_URL=

# --- Azure OpenAI (vision-capable deployment) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment used for marking and question drafting
AZURE_OPENAI_DEPLOYMENT=
# Deployment used for reading handwriting (defaults to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_VISION_DEPLOYMENT=
# Set to "true" if the deployment is a reasoning model (o-series / GPT-5) that rejects temperature
AZURE_OPENAI_REASONING_MODEL=false

# --- Email for guardian-consent messages (Resend) ---
RESEND_API_KEY=
MAIL_FROM="KHOJO PAPERS <no-reply@example.com>"

# --- Limits and retention ---
AI_DAILY_LIMIT_PER_USER=30
CONSENT_PENDING_TTL_DAYS=7
AI_RUN_RETENTION_DAYS=90

# Shared secret for the daily retention job at /api/cron/purge (at least 16 characters)
CRON_SECRET=
