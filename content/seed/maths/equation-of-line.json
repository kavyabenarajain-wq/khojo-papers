      "code": "M10-EQL-001",
      "topics": [
        "slope-intercept"
      ],
      "answerFormat": "mcq",
      "marks": 1,
      "difficulty": "easy",
      "content": {
        "stem": "The slope and the y-intercept of the line \\(3x - 4y + 12 = 0\\) are respectively:",
        "options": [
          {
            "key": "a",
            "text": "\\(\\tfrac{3}{4}\\) and \\(-3\\)"
          },
          {
            "key": "b",
            "text": "\\(-\\tfrac{3}{4}\\) and \\(3\\)"
          },
          {
            "key": "c",
            "text": "\\(\\tfrac{3}{4}\\) and \\(3\\)"
          },
          {
            "key": "d",
            "text": "\\(\\tfrac{4}{3}\\) and \\(3\\)"
          }
        ]
      },
      "answerKey": {
        "type": "mcq",
        "correct": "c"
      },
      "hints": [
        "Rearrange the equation into the form \\(y = mx + c\\)."
      ],
      "solution": {
        "modelAnswer": "\\(4y = 3x + 12 \\Rightarrow y = \\tfrac{3}{4}x + 3\\). Slope \\(= \\tfrac{3}{4}\\), y-intercept \\(= 3\\). Option (c).",
        "finalAnswer": "(c) slope \\(\\tfrac{3}{4}\\), y-intercept \\(3\\)",
        "steps": [
          {
            "n": 1,
            "title": "Make y the subject",
            "expression": "3x - 4y + 12 = 0 \\Rightarrow 4y = 3x + 12 \\Rightarrow y = \\tfrac{3}{4}x + 3",
            "explanation": "Move the y-term to one side and divide by 4.",
            "rule": "Slope-intercept form \\(y = mx + c\\)"
          },
          {
            "n": 2,
            "title": "Read off m and c",
            "expression": "m = \\tfrac{3}{4},\\quad c = 3",
            "result": "\\tfrac{3}{4},\\ 3",
            "explanation": "The coefficient of \\(x\\) is the slope and the constant is the y-intercept. This is option (c).",
            "isFinal": true
          }
        ],
        "commonMistakes": [
          "Option (a) or (b): sign slips while moving terms across the equals sign.",
          "Option (d): taking the slope as \\(\\tfrac{4}{3}\\) by dividing the coefficients the wrong way round (\\(-\\tfrac{b}{a}\\) instead of \\(-\\tfrac{a}{b}\\))."
        ],
        "alternativeMethods": [
          {
            "title": "Using the general form",
            "description": "For \\(ax + by + c = 0\\), slope \\(= -\\tfrac{a}{b} = -\\tfrac{3}{-4} = \\tfrac{3}{4}\\) and y-intercept \\(= -\\tfrac{c}{b} = -\\tfrac{12}{-4} = 3\\)."
          }
        ]
      },
      "rubric": {
        "criteria": [
          {
            "key": "answer",
            "description": "Selects the correct slope and intercept",
            "marks": 1,
            "expectedEvidence": "Option (c)",
            "acceptedAlternatives": [],
            "commonErrors": [
              "(a)",
              "(b)",
              "(d)"
            ]
          }
        ]
      }
    },
