      "solution": {
        "modelAnswer": "(a) \\(4 - 3x < 2x + 14 \\Rightarrow -10 < 5x \\Rightarrow x > -2\\). \\(A = \\{-1, 0, 1, 2, \\ldots\\}\\).\n\n(b) \\(x + 5 \\ge 3x - 1 \\Rightarrow 6 \\ge 2x \\Rightarrow x \\le 3\\). \\(B = \\{\\ldots, 1, 2, 3\\}\\).\n\n(c) \\(A \\cap B = \\{-1, 0, 1, 2, 3\\}\\), shown as five filled dots at \\(-1, 0, 1, 2, 3\\) on a number line.",
        "finalAnswer": "\\(A = \\{-1, 0, 1, 2, \\ldots\\}\\), \\(B = \\{\\ldots, 1, 2, 3\\}\\), \\(A \\cap B = \\{-1, 0, 1, 2, 3\\}\\)",
        "steps": [
          {
            "n": 1,
            "partKey": "a",
            "title": "Expand and collect",
            "expression": "4 - 3x < 2x + 14 \\;\\Rightarrow\\; 4 - 14 < 2x + 3x \\;\\Rightarrow\\; -10 < 5x",
            "explanation": "Expand the bracket, then move the \\(x\\)-terms to the right and the numbers to the left."
          },
          {
            "n": 2,
            "partKey": "a",
            "title": "Solve and list A",
            "expression": "x > -2, \\quad x \\in I",
            "result": "A = \\{-1, 0, 1, 2, \\ldots\\}",
            "explanation": "Divide by 5 (positive, so no change of sign). The integers greater than \\(-2\\) start at \\(-1\\).",
            "isFinal": true
          },
          {
            "n": 3,
            "partKey": "b",
            "title": "Clear the fractions",
            "expression": "3 \\times \\frac{x + 5}{3} \\ge 3x - 3 \\times \\frac{1}{3} \\;\\Rightarrow\\; x + 5 \\ge 3x - 1",
            "explanation": "Multiply both sides by 3."
          },
          {
            "n": 4,
            "partKey": "b",
            "title": "Solve and list B",
            "expression": "6 \\ge 2x \\;\\Rightarrow\\; x \\le 3, \\quad x \\in I",
            "result": "B = \\{\\ldots, 1, 2, 3\\}",
            "explanation": "Collect terms and divide by 2. The integers less than or equal to 3 end at 3.",
            "isFinal": true
          },
          {
            "n": 5,
            "partKey": "c",
            "title": "Intersection",
            "expression": "A \\cap B = \\{x : -2 < x \\le 3,\\ x \\in I\\}",
            "result": "A \\cap B = \\{-1, 0, 1, 2, 3\\}",
            "explanation": "Take the integers that are in both sets: greater than \\(-2\\) and at most 3."
          },
          {
            "n": 6,
            "partKey": "c",
            "title": "Number line",
            "explanation": "Since \\(x\\) is an integer, mark separate filled dots at \\(-1, 0, 1, 2\\) and 3 only.",
            "diagramId": "nl2",
            "isFinal": true
          }
        ],
