{
  "name": "khojo-papers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check-content": "tsx --tsconfig tsconfig.json scripts/check-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx --conditions=react-server scripts/seed.mts",
    "setup:storage": "tsx --conditions=react-server scripts/setup-storage.mts",
    "user:roles": "tsx --conditions=react-server scripts/set-roles.mts",
    "purge": "tsx --conditions=react-server scripts/purge.mts",
    "local-db": "tsx scripts/local-db.mts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
